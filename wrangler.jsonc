{
	"name": "gapem",
	"compatibility_date": "2026-09-23",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist"
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "gapem.lol/*",
			"zone_name": "gapem.lol"
		},
		{
			"pattern": "www.gapem.lol/*",
			"zone_name": "gapem.lol"
		}
	],
	"kv_namespaces": [
		{
			"binding": "GAPEM_KV",
			"id": "d755d25a5a774fce82a8e3aa022d8d4d",
			"remote": true
		}
	]
}